# Salin ke .env.local lalu isi dari Supabase → Project Settings → API Keys.
# Keduanya aman berada di browser karena semua data dilindungi Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# UUID akun pemilik (Supabase → Authentication → Users → User UID).
# Hanya dibaca di server; JANGAN diberi awalan NEXT_PUBLIC_.
ACADOCS_OWNER_ID=

# API key Anthropic untuk fitur "Cek Progres" (console.anthropic.com → API Keys).
# Rahasia server: JANGAN diberi awalan NEXT_PUBLIC_. Kosong = fitur Cek Progres nonaktif.
ANTHROPIC_API_KEY=

# JANGAN menambahkan secret key / service_role key Supabase ke project ini.
