# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env template boleh di-commit (tanpa nilai)
!.env.example

# supabase cli
supabase/.temp/
supabase/.branches/

